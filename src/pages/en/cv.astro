---
import PageLayout from '../../layouts/PageLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { SITE_URL } from '../../consts';

const lang = 'en' as const;
const t = useTranslations(lang);
const alternateUrls = [{ lang: 'fr' as const, url: `${SITE_URL}/fr/cv` }];

const skills = {
  Frontend: ['HTML', 'CSS', 'JavaScript', 'TypeScript', 'React', 'Astro'],
  Mobile: ['React Native', 'Expo'],
  Backend: ['Java', 'Spring Boot', 'REST API'],
  Database: ['PostgreSQL', 'MySQL'],
  Tools: ['Git', 'Docker', 'Linux', 'Caddy'],
};
---

<PageLayout
  lang={lang}
  title={t('cv.title')}
  description="Online resume of Any Gnahiet, full-stack developer."
  alternateUrls={alternateUrls}
>
  <div class="cv-page">
    <div class="cv-header">
      <div>
        <h1>Any Gnahiet</h1>
        <p class="cv-subtitle">{t('hero.subtitle')}</p>
      </div>
      <a href="/cv/cv-en.pdf" download class="btn-download" aria-label={t('cv.downloadLabel')}>
        ↓ {t('cv.download')}
      </a>
    </div>

    <p class="pdf-notice">{t('cv.pdfNotice')}</p>

    <section aria-labelledby="section-summary">
      <h2 id="section-summary">{t('cv.summary')}</h2>
      <p>
        Passionate full-stack developer focused on building robust web and mobile applications.
        Comfortable across the entire stack, from React components to Spring Boot APIs and Docker
        infrastructure. I pay close attention to code quality, accessibility and performance.
      </p>
    </section>

    <section aria-labelledby="section-skills">
      <h2 id="section-skills">{t('cv.skills')}</h2>
      <dl class="skills-grid">
        {
          Object.entries(skills).map(([category, items]) => (
            <div class="skill-group">
              <dt>{category}</dt>
              <dd>
                <ul role="list" class="skill-list">
                  {items.map((skill) => (
                    <li class="skill-badge">{skill}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="section-experience">
      <h2 id="section-experience">{t('cv.experience')}</h2>
      <p class="placeholder-notice">— To be filled with your professional experience.</p>
    </section>

    <section aria-labelledby="section-education">
      <h2 id="section-education">{t('cv.education')}</h2>
      <p class="placeholder-notice">— To be filled with your educational background.</p>
    </section>
  </div>
</PageLayout>

<style>
  .cv-page {
    max-width: var(--max-width-prose);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .cv-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cv-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--transition-fast);
    flex-shrink: 0;
  }

  .btn-download:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }

  .pdf-notice {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--color-border);
    margin-top: calc(-1 * var(--space-8));
  }

  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  p {
    line-height: 1.8;
    color: var(--color-text);
  }

  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .skill-group {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  dt {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    padding-top: var(--space-1);
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .skill-badge {
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: var(--color-bg-subtle);
  }

  .placeholder-notice {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
