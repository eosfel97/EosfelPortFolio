---
import PageLayout from '../../../layouts/PageLayout.astro';
import { SITE_URL } from '../../../consts';

const lang = 'en' as const;
const alternateUrls = [{ lang: 'fr' as const, url: `${SITE_URL}/fr/blog` }];
---

<PageLayout
  lang={lang}
  title="Blog"
  description="Technical notes and articles — coming soon."
  alternateUrls={alternateUrls}
  noindex
>
  <section style="max-width:42rem;margin:6rem auto;padding:0 1.5rem;text-align:center;">
    <h1 style="font-size:2.5rem;margin:0 0 1rem;">Blog</h1>
    <p style="color:var(--yk-ink-soft);font-size:1.1rem;line-height:1.6;">
      Technical notes and articles will land here soon. In the meantime, head to the <a
        href="/en"
        style="color:var(--yk-seal);">home page</a
      >.
    </p>
  </section>
</PageLayout>
