---
import type { Locale } from '../../consts';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  currentLang: Locale;
  pathname: string;
  label: string;
}

const { currentLang, pathname, label } = Astro.props;
const targetLang: Locale = currentLang === 'fr' ? 'en' : 'fr';
const targetPath = getLocalizedPath(pathname, targetLang);
---

<a href={targetPath} aria-label={label} class="lang-switcher" hreflang={targetLang}>
  {targetLang.toUpperCase()}
</a>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .lang-switcher:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
