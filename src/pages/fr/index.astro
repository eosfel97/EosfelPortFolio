---
import PageLayout from '../../layouts/PageLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { SITE_URL } from '../../consts';

const lang = 'fr' as const;
const t = useTranslations(lang);
const alternateUrls = [{ lang: 'en' as const, url: `${SITE_URL}/en` }];
---

<PageLayout
  lang={lang}
  title="Accueil"
  description="Portfolio de Any Gnahiet, développeur full-stack spécialisé en React, Spring Boot et React Native."
  alternateUrls={alternateUrls}
>
  <section class="hero">
    <h1>{t('hero.title')}</h1>
    <p class="subtitle">{t('hero.subtitle')}</p>
    <a href="/fr/projects" class="cta">{t('hero.cta')}</a>
  </section>
</PageLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 60vh;
    gap: var(--space-6);
    padding: var(--space-16) var(--space-6);
    max-width: var(--max-width-content);
    margin: 0 auto;
  }

  h1 {
    font-size: var(--text-4xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
  }

  .cta {
    display: inline-block;
    padding: var(--space-3) var(--space-8);
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .cta:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }
</style>
