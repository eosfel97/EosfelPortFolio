---
import PageLayout from '../../../layouts/PageLayout.astro';
import { SITE_URL } from '../../../consts';

const lang = 'fr' as const;
const alternateUrls = [{ lang: 'en' as const, url: `${SITE_URL}/en/blog` }];
---

<PageLayout
  lang={lang}
  title="Blog"
  description="Notes et articles techniques — à venir."
  alternateUrls={alternateUrls}
  noindex
>
  <section style="max-width:42rem;margin:6rem auto;padding:0 1.5rem;text-align:center;">
    <h1 style="font-size:2.5rem;margin:0 0 1rem;">Blog</h1>
    <p style="color:var(--yk-ink-soft);font-size:1.1rem;line-height:1.6;">
      Les notes et articles techniques arriveront bientôt. En attendant, vous pouvez consulter <a
        href="/fr"
        style="color:var(--yk-seal);">la page d'accueil</a
      >.
    </p>
  </section>
</PageLayout>
