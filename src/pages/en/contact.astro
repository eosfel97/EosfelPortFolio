---
import PageLayout from '../../layouts/PageLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { SITE_URL, SOCIAL_LINKS } from '../../consts';

const lang = 'en' as const;
const t = useTranslations(lang);
const alternateUrls = [{ lang: 'fr' as const, url: `${SITE_URL}/fr/contact` }];

const EMAIL = 'any.gouba@gmail.com';
---

<PageLayout
  lang={lang}
  title={t('contact.title')}
  description="Contact Any Gnahiet, full-stack developer."
  alternateUrls={alternateUrls}
>
  <div class="contact-page">
    <header class="contact-header">
      <h1>{t('contact.title')}</h1>
      <p class="subtitle">{t('contact.subtitle')}</p>
    </header>

    <div class="contact-card">
      <a href={`mailto:${EMAIL}`} class="email-link" aria-label={t('contact.email')}>
        <span class="email-icon" aria-hidden="true">✉</span>
        <span>{EMAIL}</span>
      </a>
      <p class="response-time">{t('contact.response')}</p>
    </div>

    <div class="social-section">
      <p>{t('contact.or')}</p>
      <ul class="social-links" role="list">
        <li>
          <a
            href={SOCIAL_LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            GitHub
          </a>
        </li>
        <li>
          <a
            href={SOCIAL_LINKS.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </div>
</PageLayout>

<style>
  .contact-page {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .contact-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .email-link:hover {
    color: var(--color-accent-hover);
  }

  .email-icon {
    font-size: var(--text-2xl);
  }

  .response-time {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .social-section {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .social-section p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .social-links {
    display: flex;
    gap: var(--space-3);
    list-style: none;
  }

  .social-link {
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-fast);
  }

  .social-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
