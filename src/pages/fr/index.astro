---
import '../../styles/yamikage.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KunaiCursor from '../../components/home/KunaiCursor.tsx';
import YamikageChrome from '../../components/home/YamikageChrome.tsx';
import Hero from '../../components/home/Hero.tsx';
import Projects from '../../components/home/Projects.tsx';
import Stack from '../../components/home/Stack.tsx';
import Homelab from '../../components/home/Homelab.tsx';
import Timeline from '../../components/home/Timeline.tsx';
import Contact from '../../components/home/Contact.tsx';
import { SITE_URL, SOCIAL_LINKS } from '../../consts';
import { PORTFOLIO_DATA } from '../../data/portfolio';

const lang = 'fr' as const;

const alternateUrls = [{ lang: 'en' as const, url: `${SITE_URL}/en` }];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PORTFOLIO_DATA.identity.name,
  url: SITE_URL,
  jobTitle: PORTFOLIO_DATA.identity.role.fr,
  sameAs: [SOCIAL_LINKS.github, SOCIAL_LINKS.linkedin],
};
---

<BaseLayout
  lang={lang}
  description="Portfolio de Any Gnahiet, développeur full-stack & réseau — React, Spring Boot, React Native, Linux & self-hosting."
  alternateUrls={alternateUrls}
  jsonLd={jsonLd}
>
  <main id="main-content" class="v-yk2">
    <KunaiCursor client:only="react" />
    <YamikageChrome client:only="react" lang={lang} />

    <Hero client:visible lang={lang} />
    <Projects client:visible lang={lang} />
    <Stack client:visible lang={lang} />
    <Homelab client:visible lang={lang} />
    <Timeline client:visible lang={lang} />
    <Contact client:visible lang={lang} />
  </main>
</BaseLayout>
