---
import PageLayout from '../../layouts/PageLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { SITE_URL, SOCIAL_LINKS } from '../../consts';

const lang = 'fr' as const;
const t = useTranslations(lang);
const alternateUrls = [{ lang: 'en' as const, url: `${SITE_URL}/en/about` }];

const stack = [
  { label: 'Frontend', items: ['React', 'TypeScript', 'Astro', 'HTML/CSS'] },
  { label: 'Mobile', items: ['React Native', 'Expo'] },
  { label: 'Backend', items: ['Java', 'Spring Boot', 'REST API'] },
  { label: 'Infra', items: ['Docker', 'Linux', 'Caddy', 'Cloudflare'] },
];
---

<PageLayout
  lang={lang}
  title={t('about.title')}
  description="À propos d'Any Gnahiet, développeur full-stack passionné par le web, le mobile et l'auto-hébergement."
  alternateUrls={alternateUrls}
>
  <div class="about-page">
    <section class="intro-section" aria-labelledby="about-intro">
      <div class="intro-text">
        <h1 id="about-intro">{t('about.intro')}</h1>
        <p>
          Je suis <strong>Any Gnahiet</strong>, développeur full-stack basé en France. Je conçois
          des applications web et mobiles en accordant une attention particulière à la qualité du
          code, à l'accessibilité et aux performances.
        </p>
        <p>
          J'aime travailler sur l'ensemble de la stack — du composant React jusqu'au déploiement
          Docker sur mon serveur auto-hébergé. Cette maîtrise bout-en-bout me permet de prendre des
          décisions cohérentes à chaque couche du projet.
        </p>
        <p class="placeholder-notice">
          — <em>À personnaliser avec votre propre parcours et votre histoire.</em>
        </p>
      </div>
      <div class="intro-avatar" aria-hidden="true">
        <div class="avatar-placeholder">AG</div>
      </div>
    </section>

    <section aria-labelledby="about-what">
      <h2 id="about-what">{t('about.what')}</h2>
      <dl class="stack-grid">
        {
          stack.map(({ label, items }) => (
            <div class="stack-group">
              <dt>{label}</dt>
              <dd>
                <ul role="list" class="badge-list">
                  {items.map((item) => (
                    <li class="badge">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="about-values">
      <h2 id="about-values">{t('about.values')}</h2>
      <ul class="values-list" role="list">
        <li>
          <strong>Accessibilité</strong> — un site doit être utilisable par tout le monde, clavier et
          lecteur d'écran inclus.
        </li>
        <li>
          <strong>Performance</strong> — le moins de JavaScript possible sur les pages statiques ; des
          îlots React uniquement là où l'interactivité est nécessaire.
        </li>
        <li>
          <strong>Autonomie</strong> — je préfère auto-héberger mes projets et comprendre chaque couche
          de l'infrastructure plutôt que de dépendre de solutions opaques.
        </li>
        <li>
          <strong>Open source</strong> — tout le code de ce portfolio est public.
        </li>
      </ul>
    </section>

    <section class="cta-section" aria-label="Prendre contact">
      <p>Curieux d'en savoir plus ou intéressé par une collaboration ?</p>
      <div class="cta-links">
        <a href="/fr/contact" class="btn btn--primary">Me contacter</a>
        <a
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--secondary"
        >
          GitHub
        </a>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .about-page {
    max-width: var(--max-width-prose);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* Intro */
  .intro-section {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-8);
    align-items: start;
  }

  .intro-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .intro-text p {
    line-height: 1.8;
    color: var(--color-text);
  }

  .avatar-placeholder {
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: var(--color-bg-subtle);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text-muted);
  }

  /* Sections */
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  /* Stack grid */
  .stack-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stack-group {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  dt {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    padding-top: var(--space-1);
  }

  .badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .badge {
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: var(--color-bg-subtle);
  }

  /* Values */
  .values-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    list-style: none;
    padding-left: 0;
  }

  .values-list li {
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-accent);
    line-height: 1.7;
  }

  /* CTA */
  .cta-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    align-items: flex-start;
  }

  .cta-section p {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .cta-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .btn {
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn--primary {
    background: var(--color-accent);
    color: #fff;
  }
  .btn--primary:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }
  .btn--secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .btn--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .placeholder-notice {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .intro-section {
      grid-template-columns: 1fr;
    }
    .intro-avatar {
      display: none;
    }
    .stack-group {
      grid-template-columns: 1fr;
    }
  }
</style>
