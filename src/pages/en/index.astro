---
import '../../styles/yamikage.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KunaiCursor from '../../components/home/KunaiCursor.tsx';
import YamikageChrome from '../../components/home/YamikageChrome.tsx';
import Home from '../../components/home/Home.tsx';
import { SITE_URL, SOCIAL_LINKS } from '../../consts';
import { PORTFOLIO_DATA } from '../../data/portfolio';

const lang = 'en' as const;

const alternateUrls = [{ lang: 'fr' as const, url: `${SITE_URL}/fr` }];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PORTFOLIO_DATA.identity.name,
  url: SITE_URL,
  jobTitle: PORTFOLIO_DATA.identity.role.en,
  sameAs: [SOCIAL_LINKS.github, SOCIAL_LINKS.linkedin],
};
---

<BaseLayout
  lang={lang}
  description="Portfolio of Any Gnahiet, full-stack developer & networking — React, Spring Boot, React Native, Linux & self-hosting."
  alternateUrls={alternateUrls}
  jsonLd={jsonLd}
>
  <main id="main-content" class="v-yk2">
    <KunaiCursor client:only="react" />
    <YamikageChrome client:only="react" />

    <Home client:visible lang={lang} />
  </main>
</BaseLayout>
