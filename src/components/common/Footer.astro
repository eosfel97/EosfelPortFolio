---
import type { Locale } from '../../consts';
import { SOCIAL_LINKS, SITE_URL } from '../../consts';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-copy">
      © {year} Any Gnahiet — {t('footer.rights')}
    </p>
    <nav aria-label={lang === 'fr' ? 'Liens du pied de page' : 'Footer links'}>
      <ul class="footer-links" role="list">
        <li>
          <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer"> GitHub </a>
        </li>
        <li>
          <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer"> LinkedIn </a>
        </li>
        <li>
          <a href={`${SITE_URL}/${lang}`}>{t('footer.sourceCode')}</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-16);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: var(--space-6);
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    font-size: var(--text-sm);
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }
</style>
