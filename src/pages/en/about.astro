---
import PageLayout from '../../layouts/PageLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { SITE_URL, SOCIAL_LINKS } from '../../consts';

const lang = 'en' as const;
const t = useTranslations(lang);
const alternateUrls = [{ lang: 'fr' as const, url: `${SITE_URL}/fr/about` }];

const stack = [
  { label: 'Frontend', items: ['React', 'TypeScript', 'Astro', 'HTML/CSS'] },
  { label: 'Mobile', items: ['React Native', 'Expo'] },
  { label: 'Backend', items: ['Java', 'Spring Boot', 'REST API'] },
  { label: 'Infra', items: ['Docker', 'Linux', 'Caddy', 'Cloudflare'] },
];
---

<PageLayout
  lang={lang}
  title={t('about.title')}
  description="About Any Gnahiet, full-stack developer passionate about web, mobile and self-hosting."
  alternateUrls={alternateUrls}
>
  <div class="about-page">
    <section class="intro-section" aria-labelledby="about-intro">
      <div class="intro-text">
        <h1 id="about-intro">{t('about.intro')}</h1>
        <p>
          I'm <strong>Any Gnahiet</strong>, a full-stack developer based in France. I build web and
          mobile applications with a strong focus on code quality, accessibility and performance.
        </p>
        <p>
          I enjoy working across the entire stack — from React components to Docker deployments on
          my self-hosted server. This end-to-end ownership allows me to make consistent decisions at
          every layer of a project.
        </p>
        <p class="placeholder-notice">
          — <em>Customize this with your own background and story.</em>
        </p>
      </div>
      <div class="intro-avatar" aria-hidden="true">
        <div class="avatar-placeholder">AG</div>
      </div>
    </section>

    <section aria-labelledby="about-what">
      <h2 id="about-what">{t('about.what')}</h2>
      <dl class="stack-grid">
        {
          stack.map(({ label, items }) => (
            <div class="stack-group">
              <dt>{label}</dt>
              <dd>
                <ul role="list" class="badge-list">
                  {items.map((item) => (
                    <li class="badge">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="about-values">
      <h2 id="about-values">{t('about.values')}</h2>
      <ul class="values-list" role="list">
        <li>
          <strong>Accessibility</strong> — a site should be usable by everyone, including keyboard and
          screen reader users.
        </li>
        <li>
          <strong>Performance</strong> — as little JavaScript as possible on static pages; React islands
          only where interactivity is truly needed.
        </li>
        <li>
          <strong>Ownership</strong> — I prefer self-hosting my projects and understanding every layer
          of the infrastructure rather than depending on opaque platforms.
        </li>
        <li>
          <strong>Open source</strong> — all the code for this portfolio is public.
        </li>
      </ul>
    </section>

    <section class="cta-section" aria-label="Get in touch">
      <p>Want to learn more or interested in working together?</p>
      <div class="cta-links">
        <a href="/en/contact" class="btn btn--primary">Get in touch</a>
        <a
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--secondary"
        >
          GitHub
        </a>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .about-page {
    max-width: var(--max-width-prose);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .intro-section {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-8);
    align-items: start;
  }

  .intro-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  h1 {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .intro-text p {
    line-height: 1.8;
    color: var(--color-text);
  }

  .avatar-placeholder {
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: var(--color-bg-subtle);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-text-muted);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .stack-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stack-group {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  dt {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    padding-top: var(--space-1);
  }

  .badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .badge {
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: var(--color-bg-subtle);
  }

  .values-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    list-style: none;
    padding-left: 0;
  }

  .values-list li {
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-accent);
    line-height: 1.7;
  }

  .cta-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    align-items: flex-start;
  }

  .cta-section p {
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .cta-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .btn {
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn--primary {
    background: var(--color-accent);
    color: #fff;
  }
  .btn--primary:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }
  .btn--secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .btn--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .placeholder-notice {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .intro-section {
      grid-template-columns: 1fr;
    }
    .intro-avatar {
      display: none;
    }
    .stack-group {
      grid-template-columns: 1fr;
    }
  }
</style>
